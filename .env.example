# Local inference by default. Generate a fresh key with scripts/setup.sh.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
LAYA_DEVICE=cuda
LAYA_API_KEY=replace-with-a-random-local-key
LAYA_PRELOAD=1
LAYA_MODELS=typed-decisions
LAYA_MAX_LOADED=2
LAYA_MAX_CONCURRENT=2
LAYA_MAX_TOKEN_BUDGET=2048
LAYA_THREADS=4
LAYA_CUDA_AMP=fp16
LAYA_REVISION=reviewed
USE_TF=0
TOKENIZERS_PARALLELISM=false
HF_HUB_DISABLE_TELEMETRY=1
